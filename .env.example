# Este arquivo e opcional. O jeito recomendado e configurar pela dashboard,
# que salva os perfis em tracking.profiles.json (um perfil por cliente).
# Valores definidos aqui tem precedencia sobre o perfil ativo.

# Google Tag Manager
GTM_ACCOUNT_ID=123456789
GTM_CONTAINER_NAME="Web Tracking"
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Cloudflare — o token precisa de "Workers Scripts: Edit" E "D1: Edit"
CLOUDFLARE_API_TOKEN=seu_api_token_aqui
CLOUDFLARE_ACCOUNT_ID=seu_account_id_aqui

# Banco Cloudflare D1
# Deixe o ID vazio na primeira execucao: o setup cria o banco e preenche sozinho.
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_DATABASE_NAME=tracking-db

# Worker
WORKER_NAME=tracking-worker-agent

# Dominio proprio de rastreamento (opcional, mas recomendado).
# Precisa estar na mesma conta Cloudflare. Sem isso, usa *.workers.dev.
TRACKING_DOMAIN=

# Gravar page_view no banco? Padrao false — economiza escrita do D1 e o GA4
# continua recebendo os pageviews normalmente.
TRACK_PAGE_VIEWS=false

# Etapas do funil — order bump / upsell / downsell (opcional).
# Order bump, upsell e downsell chegam como vendas separadas do mesmo cliente;
# o que os diferencia e o produto. Liste os ids (ou nomes) de cada etapa,
# separados por virgula. Prefixe com "re:" para regex. O que nao casar com
# nenhuma lista e tratado como front (produto principal).
FRONT_PRODUCT_IDS=
ORDER_BUMP_PRODUCT_IDS=
UPSELL_PRODUCT_IDS=
DOWNSELL_PRODUCT_IDS=

# Rodar um perfil especifico em vez do ativo (opcional)
# SETUP_PROFILE=cliente-a

PRODUCT_LIST='[{"name":"Curso A","item_id":"curso-a"}, {"name":"Curso B","item_id":"curso-b"}]'

GOOGLE_ADS_OAUTH_CLIENT_ID=seu_client_id_aqui.apps.googleusercontent.com
GOOGLE_ADS_OAUTH_CLIENT_SECRET=seu_client_secret_aqui